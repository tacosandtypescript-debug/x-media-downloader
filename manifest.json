{
  "manifest_version": 3,
  "name": "Descargador de medios para X",
  "version": "2.8.1",
  "description": "Añade un botón flotante \"Descargar\" sobre los vídeos, imágenes y audio de X (Twitter), Instagram, Facebook, YouTube y Pixabay para guardarlos en la máxima calidad, con opción de solo audio (M4A/MP3).",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Descargador de medios para X",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "downloads",
    "storage",
    "activeTab",
    "scripting",
    "offscreen",
    "nativeMessaging"
  ],
  "host_permissions": [
    "*://*.x.com/*",
    "*://*.twitter.com/*",
    "*://pbs.twimg.com/*",
    "*://*.instagram.com/*",
    "*://*.cdninstagram.com/*",
    "*://*.facebook.com/*",
    "*://*.fb.watch/*",
    "*://*.fbcdn.net/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.x.com/*",
        "*://*.twitter.com/*",
        "*://*.instagram.com/*",
        "*://*.facebook.com/*",
        "*://*.fb.watch/*",
        "*://*.youtube.com/*",
        "*://*.pixabay.com/*"
      ],
      "js": [
        "page-bridge.js"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "*://*.x.com/*",
        "*://*.twitter.com/*",
        "*://*.instagram.com/*",
        "*://*.facebook.com/*",
        "*://*.fb.watch/*",
        "*://*.youtube.com/*",
        "*://*.pixabay.com/*"
      ],
      "js": [
        "content.js",
        "images.js",
        "instagram.js",
        "facebook.js",
        "youtube.js",
        "pixabay.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
